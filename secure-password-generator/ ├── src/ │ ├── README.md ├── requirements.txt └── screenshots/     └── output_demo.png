      ],
      "source": [
        "import random\n",
        "import string\n",
        "\n",
        "length =12\n",
        "\n",
        "characters =string.ascii_letters + string.digits + string.punctuation\n",
        "password = ''.join(random.choice(characters) for i in range(length))\n",
        "\n",
        "print(\"Your Password:\",password)"
      ]
